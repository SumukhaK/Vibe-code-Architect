[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">=3.12"
dependencies = []

[project.optional-dependencies]
dev = [
  "pytest>=8",
  "pytest-cov>=5",
  "ruff>=0.6",
  "pyright>=1.1.380",
  "import-linter>=2.0",
  "vulture>=2.11",
  "diff-cover>=9",
]

[tool.setuptools.packages.find]
where = ["src"]

# ---------------------------------------------------------------- lint
[tool.ruff]
line-length = 100
target-version = "py312"

[tool.ruff.lint]
select = [
  "E", "W", "F",  # pycodestyle + pyflakes
  "I",            # import order
  "B",            # bugbear: likely bugs
  "UP",           # modern syntax
  "SIM",          # simpler code
  "C90",          # complexity
  "ERA",          # commented-out code
  "TID",          # banned APIs (below)
  "BLE",          # no blind `except Exception`
  "PL",           # pylint subset
  "RUF",
]

[tool.ruff.lint.mccabe]
max-complexity = 10

[tool.ruff.lint.flake8-tidy-imports]
ban-relative-imports = "all"

# Banned APIs: every repeated agent mistake becomes an entry here (see docs/corrections.md).
[tool.ruff.lint.flake8-tidy-imports.banned-api]
"time.sleep".msg = "Don't patch timing problems with sleeps in product code. Fix the cause, or inject a clock/scheduler."

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["PLR2004", "TID251"]

# ---------------------------------------------------------------- types
[tool.pyright]
include = ["src", "tests"]
typeCheckingMode = "strict"
pythonVersion = "3.12"

# ---------------------------------------------------------------- boundaries
[tool.importlinter]
root_package = "{{ package_name }}"

[[tool.importlinter.contracts]]
name = "Domain stays pure: it never imports adapters"
type = "forbidden"
source_modules = ["{{ package_name }}.domain"]
forbidden_modules = ["{{ package_name }}.adapters"]

# ---------------------------------------------------------------- dead code
[tool.vulture]
paths = ["src"]
min_confidence = 80

# ---------------------------------------------------------------- tests
[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q --cov={{ package_name }} --cov-report=term-missing --cov-report=xml --cov-fail-under=85"
