name: Android

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  checks:
    name: Android checks
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
      - uses: gradle/actions/setup-gradle@v4
      - name: Unit + architecture tests, detekt, Android lint, screenshot tests
        run: ./gradlew testDebugUnitTest detekt lint verifyRoborazziDebug
      - name: Attach proof to the run (screenshots and reports)
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: proof-${{ github.sha }}
          path: |
            **/build/outputs/roborazzi/**
            **/build/reports/detekt/**
            **/build/reports/lint-results-*.html
            **/build/reports/tests/**
          if-no-files-found: ignore
